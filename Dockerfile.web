# Development image with live reload.
FROM node:22-alpine AS development
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install
COPY . .
EXPOSE 3000
CMD ["pnpm", "run", "dev", "--hostname", "0.0.0.0", "--port", "3000"]

# Production build.
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build

# Static assets served by nginx. Client-side routes fall back to index.html.
FROM nginx:alpine AS production
COPY --from=build /app/dist /usr/share/nginx/html
COPY Dockerfile.nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
